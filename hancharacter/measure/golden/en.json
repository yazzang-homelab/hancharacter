    {"text": "Well, that is a fine kettle.", "matches": {"lexical_register": false, "sentence_habit": true, "orthographic_distortion": false}},
    {"text": "I reckon we leave at dawn.", "matches": {"lexical_register": true, "sentence_habit": true, "orthographic_distortion": false}},
    {"text": "The river is quiet.", "matches": {"lexical_register": false, "sentence_habit": false, "orthographic_distortion": false}},
    {"text": "C'mon, mate, keep up.", "matches": {"lexical_register": true, "sentence_habit": false, "orthographic_distortion": true}},
