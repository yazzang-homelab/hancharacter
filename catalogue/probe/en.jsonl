{"id": "probe_en_polite_request", "lang": "en", "markedness": "unmarked", "origin": "authored_synthetic", "text": "Would you kindly hold the door."}
{"id": "probe_en_fleur_zis", "lang": "en", "markedness": "marked", "origin": "authored_synthetic", "text": "Zis is not what I expected at all."}
{"id": "probe_en_fleur_zat", "lang": "en", "markedness": "marked", "origin": "authored_synthetic", "text": "Zat man never listens to anyone."}
{"id": "probe_en_fleur_ze", "lang": "en", "markedness": "marked", "origin": "authored_synthetic", "text": "I will wait by ze fountain."}
{"id": "probe_en_fleur_name", "lang": "en", "markedness": "marked", "origin": "authored_synthetic", "text": "Good evening, 'Arry, you look tired."}
{"id": "probe_en_fleur_eez", "lang": "en", "markedness": "marked", "origin": "authored_synthetic", "text": "He eez always late for supper."}
{"id": "probe_en_archaic_frame", "lang": "en", "markedness": "marked", "origin": "authored_synthetic", "text": "Hear me, for I am the keeper of this gate."}
{"id": "probe_en_elder_plain", "lang": "en", "markedness": "marked", "origin": "authored_synthetic", "text": "I have lived here longer than the road has."}
{"id": "probe_en_clipped_polite", "lang": "en", "markedness": "marked", "origin": "authored_synthetic", "text": "Right away, sir, no trouble."}
